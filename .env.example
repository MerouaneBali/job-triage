# Anthropic Claude API (Stage 3)
# Loaded by CLI scripts and by the Next preview app from this repo-root file.
# Optional: symlink or copy into web/.env.local if you prefer Next-only loading.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override — current Sonnet: https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5
